#performance ready 
to_do = []

def manage_tasks(user_choice): # PARAMETER: user_choice determines if the loop runs
    while user_choice == "yes":    # ITERATION: Using a while loop to manage the list
        task = input("What would you like to add? ")
        to_do.append(task)
        
        print(f"\n--- Updated List ---")
        # ITERATION: Using a for loop to display items
        for item in to_do:
            # SELECTION: Adds a '!' to tasks that are urgent (High Priority)
            if "urgent" in item.lower():
                print(f"Priority: {item} !!")
            else:
                print(f"Task: {item}")
        
        user_choice = input("\nWould you like to add something else? (yes/no): ").lower()
    
    # Final step of Sequencing
    print("List finalized. Have a productive day!")


print("Your To Do List")
print("----------------------------------------------")
user = input("What is your name?: ")
print(f"Hello {user}! Today is a new day!")
day = input("What day is it?: ")

print(f"Your to-do list is empty for {day}.")
answer = input("Would you like to add something to your list? (yes/no): ").lower()

# CALLING THE PROCEDURE
manage_tasks(answer)

print(f"\nFinal {day} Schedule: {to_do}")